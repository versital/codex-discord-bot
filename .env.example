# Installed to /etc/codex-discord-bot.env on Linux (root-only, read by systemd)
# or C:\ProgramData\CodexDiscordBot\bot.env on Windows. Restart the bot after editing.

# Required: bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# Let Codex send files back (images it generates, voice messages, documents,
# code). Each request gets a private outbox it may write to; everything else
# stays read-only and there's no network. false = fully read-only, text only.
FILE_OUTPUT=true
MAX_OUTPUT_FILES=10
# Discord's upload limit for bots is 10 MB unless your server is boosted.
MAX_UPLOAD_MB=10

# Defaults for people who haven't picked their own with /model and /effort.
# Blank model = Codex's default. Lower effort = faster answers.
DEFAULT_MODEL=
DEFAULT_EFFORT=low
# Which efforts /effort offers, and which models /model allows (blank = all).
ALLOWED_EFFORTS=low,medium,high,xhigh
ALLOWED_MODELS=
# Let people turn on /fast (about 2x faster, uses more of your quota).
ALLOW_FAST=true

# Chats: start a new one automatically after this long without messages,
# keep this many per person, and delete chats unused for this many days.
CHAT_IDLE_MINUTES=120
MAX_CHATS_PER_USER=25
CHAT_RETENTION_DAYS=30

# Limits
CODEX_TIMEOUT_SECONDS=180
MAX_CONCURRENT=2
MAX_QUEUE=10
USER_COOLDOWN_SECONDS=5
MAX_PROMPT_CHARS=4000
# Requests per person per day (0 = unlimited; admins are exempt)
DAILY_REQUEST_LIMIT=0

# Attachments
MAX_ATTACHMENTS=10
MAX_FILE_MB=25
MAX_TOTAL_MB=50
MAX_ZIP_UNPACKED_MB=100
MAX_ZIP_FILES=1000
MAX_IMAGES=12
VIDEO_FRAMES=6
PDF_IMAGE_PAGES=4

# Who can use the bot (comma-separated IDs). Blank = anyone, in any server.
ALLOWED_GUILD_IDS=
ALLOWED_USER_IDS=
# Extra people who can use /admin (the bot's owner always can).
ADMIN_USER_IDS=

# Answer DMs too (no ping needed in DMs)
ALLOW_DMS=false

# Updates: where /admin update gets new versions, how often to check
# (0 = never), and whether to install automatically instead of just DMing you.
UPDATE_REPO=versital/codex-discord-bot
UPDATE_BRANCH=main
UPDATE_TOKEN=
UPDATE_CHECK_HOURS=6
AUTO_UPDATE=false
